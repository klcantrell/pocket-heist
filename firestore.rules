// Test mode: allows all reads and writes until 2026-04-19.
// TODO: Replace with production security rules before launch.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 4, 19);
    }
  }
}
